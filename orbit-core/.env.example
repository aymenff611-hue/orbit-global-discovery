# ORBIT Core Environment Configuration
# Copy this file to .env and customize for your deployment

# === System identity ===
ORBIT_INSTANCE_NAME=orbit-core
ORBIT_INSTANCE_ID=orbit-001

# === API and control plane ===
ORBIT_API_HOST=0.0.0.0
ORBIT_API_PORT=8000
ORBIT_API_WORKERS=4
ORBIT_API_SECRET_KEY=change-this-in-production

# === Discovery configuration ===
ORBIT_DISCOVERY_MAX_CANDIDATES_PER_DAY=1000000
ORBIT_DISCOVERY_MAX_SOURCES_PER_DAY=1000000
ORBIT_DISCOVERY_MAX_VALIDATED_PER_DAY=10000
ORBIT_DISCOVERY_REGISTRY_CAPACITY=100000000
ORBIT_DISCOVERY_ENABLE_RECURSIVE=true
ORBIT_DISCOVERY_MAX_GENERATIONS=10
ORBIT_DISCOVERY_ENABLE_DNS=true
ORBIT_DISCOVERY_ENABLE_CT=true
ORBIT_DISCOVERY_ENABLE_SITEMAP=true
ORBIT_DISCOVERY_ENABLE_RSS=true

# === Crawling configuration ===
ORBIT_CRAWL_INITIAL_PAGES_PER_DAY=100000
ORBIT_CRAWL_PRODUCTION_PAGES_PER_DAY=1000000
ORBIT_CRAWL_LARGE_PAGES_PER_DAY=10000000
ORBIT_CRAWL_MAXIMUM_PAGES_PER_DAY=100000000
ORBIT_CRAWL_MAX_CONCURRENT_WORKERS=100
ORBIT_CRAWL_PER_HOST_CONCURRENCY=2
ORBIT_CRAWL_PER_HOST_DELAY_SECONDS=1.0
ORBIT_CRAWL_RESPECT_ROBOTS_TXT=true
ORBIT_CRAWL_USER_AGENT=ORBIT-DiscoveryBot/1.0 (+https://example.com/bot)
ORBIT_CRAWL_TIMEOUT_SECONDS=30
ORBIT_CRAWL_MAX_RETRIES=5
ORBIT_CRAWL_BACKOFF_BASE_SECONDS=2.0
ORBIT_CRAWL_ENABLE_BROWSER_RENDERING=true
ORBIT_CRAWL_BROWSER_MAX_CONCURRENT=10
ORBIT_CRAWL_BROWSER_RENDER_ONLY_WHEN_NECESSARY=true

# === Storage configuration ===
ORBIT_STORAGE_HOT_RETENTION_DAYS=30
ORBIT_STORAGE_WARM_RETENTION_DAYS=365
ORBIT_STORAGE_COLD_RETENTION_DAYS=2555
ORBIT_STORAGE_COMPRESSION_ENABLED=true
ORBIT_STORAGE_DEDUPLICATION_ENABLED=true
ORBIT_STORAGE_RAW_PATH=/data/orbit/raw
ORBIT_STORAGE_EXTRACTED_PATH=/data/orbit/extracted
ORBIT_STORAGE_OBJECT_STORAGE_ENDPOINT=
ORBIT_STORAGE_OBJECT_STORAGE_BUCKET=orbit-archive

# === Queue configuration ===
ORBIT_QUEUE_BROKER_URL=redis://localhost:6379/0
ORBIT_QUEUE_RESULT_BACKEND=redis://localhost:6379/1
ORBIT_QUEUE_ENABLE_DEAD_LETTER=true
ORBIT_QUEUE_MAX_RETRIES=5

# === Database ===
ORBIT_DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit

# === Search ===
ORBIT_SEARCH_ENGINE_URL=http://localhost:9200
ORBIT_SEARCH_INDEX_PREFIX=orbit

# === Graph ===
ORBIT_GRAPH_URI=bolt://localhost:7687
ORBIT_GRAPH_USER=neo4j
ORBIT_GRAPH_PASSWORD=orbit-graph

# === Language & Geo ===
ORBIT_SUPPORTED_LANGUAGES=en,ar,es,fr,de,zh,ja,ko,ru,pt
ORBIT_SUPPORTED_COUNTRIES=
ORBIT_LANGUAGE_DETECTION_CONFIDENCE_THRESHOLD=0.7

# === Demand & Intent ===
ORBIT_DEMAND_MAX_EVENTS_PER_DAY=10000000
ORBIT_INTENT_PRECISION_TARGET=0.90
ORBIT_INTENT_RECALL_TARGET=0.80

# === Security ===
ORBIT_SECURITY_ENABLE_SSRF_PROTECTION=true
ORBIT_SECURITY_ENABLE_DNS_REBINDING_PROTECTION=true
ORBIT_SECURITY_SANDBOX_BROWSER=true
ORBIT_SECURITY_AUDIT_LOG_ENABLED=true

# === Tenant isolation ===
ORBIT_TENANT_ISOLATION_ENABLED=true

# === Adaptive discovery ===
ORBIT_ADAPTIVE_EXPLORATION_WEIGHT=0.3
ORBIT_ADAPTIVE_EXPLOITATION_WEIGHT=0.7
ORBIT_ADAPTIVE_MIN_YIELD_THRESHOLD=0.05
ORBIT_ADAPTIVE_REBALANCE_INTERVAL_SECONDS=300

# === Model tiering ===
ORBIT_MODEL_TIER1_LIGHTWEIGHT=rule-based
ORBIT_MODEL_TIER2_SPECIALIZED=small-classifier
ORBIT_MODEL_TIER3_REASONING=large-reasoning-model
ORBIT_MODEL_PROVIDER=local
